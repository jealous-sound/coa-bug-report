# Set real values in Railway > Service > Variables. This file is documentation only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=jealous-sound/azerothcore-wotlk-coa
# A separate random secret, at least 32 characters. This is NOT your GitHub token.
REPORT_API_KEY=
# Global limits on attempts to create issues (across all callers).
MAX_REPORTS_PER_HOUR=60
MIN_REPORT_INTERVAL_SECONDS=5
